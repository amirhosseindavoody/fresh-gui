{
  // Host UI chrome — applied on connect and when this file is saved.
  "ui": {
    // system | light | dark (used when palette is "primer")
    "theme": "system",
    // Color pack: primer | nord | dracula | solarized-dark | high-contrast |
    // nostalgia | dark | light (Fresh theme names where applicable)
    "palette": "primer",
    "terminalFontSize": 14,
    "editorFontSize": 14,
    // UI chrome weight (100–900, steps of 100)
    "fontWeight": 400,
    // Terminal + editor monospace weight
    "monoFontWeight": 400,
    // Optional CSS font-family overrides (empty = IBM Plex)
    "fontFamily": "",
    "monoFontFamily": "",
    "webgl": true,
    // Explorer: hide .* by default; .git stays hidden unless showGitDirs is true
    "showDotfiles": false,
    "showGitDirs": false,
    // VS Code–style editor document map (minimap). Off = not loaded (no UI cost).
    "editorMinimap": false,
    // Soft-wrap long lines (Fresh editor.line_wrap). Default on.
    "editorLineWrap": true
  },
  // Initial shell for each NEW terminal, resolved on the daemon. Save this
  // Settings file, then open a new tab; existing terminals keep their shell.
  // Set command to "pwsh", "powershell", "cmd", "fish", "bash", or a full
  // executable path. This is a path, not a command line; put flags in args.
  // If missing, Fresh logs the skipped command and falls back to pwsh,
  // powershell, %COMSPEC%, then cmd. Empty args enable OSC 7 for known shells;
  // nonempty args are passed directly to the executable.
  "terminal": {
    "shell": {
      "command": "powershell",
      "args": []
    }
  },
  // Language servers launch on the daemon host, where workspace files live.
  // Paths may be absolute or resolved through PATH. Configure only servers you installed.
  // TOML: { "command": "tombi", "args": ["lsp"] }
  // Python: Ruff { "command": "ruff", "args": ["server"], "only_features": ["diagnostics", "format"] }
  // Python: TY { "command": "ty", "args": ["server"], "only_features": ["diagnostics"] }
  // Use an array under lsp.python to run Ruff and TY together. Empty by default.
  "lsp": {},
  // Optional Fresh language associations. For custom languages, provide extensions
  // or exact filenames, for example: "my_lang": { "extensions": ["ml"] }.
  "languages": {},
  // action is the Rust action name to run. when is an optional GPUI focus
  // context: null means global; Explorer, Editor, and Terminal scope keys to a pane.
  // TerminalCopyOrInterrupt copies a selection, otherwise sends Ctrl+C to the PTY.
  "shortkeys": [
    { "action": "NewTerminal", "shortkey": "ctrl-t", "when": null },
    { "action": "CloseTab", "shortkey": "ctrl-w", "when": null },
    { "action": "SaveBuffer", "shortkey": "ctrl-s", "when": null },
    { "action": "ToggleWordWrap", "shortkey": "alt-z", "when": "Editor" },
    { "action": "ToggleSidebar", "shortkey": "ctrl-b", "when": null },
    { "action": "ToggleCommandPalette", "shortkey": "ctrl-shift-p", "when": null },
    { "action": "GoToFile", "shortkey": "ctrl-p", "when": null },
    { "action": "OpenSettings", "shortkey": "ctrl-,", "when": null },
    { "action": "NextTab", "shortkey": "ctrl-tab", "when": null },
    { "action": "PrevTab", "shortkey": "ctrl-shift-tab", "when": null },
    { "action": "Reconnect", "shortkey": "ctrl-shift-r", "when": null },
    { "action": "CopyExplorer", "shortkey": "ctrl-c", "when": "Explorer" },
    { "action": "CopyExplorer", "shortkey": "cmd-c", "when": "Explorer" },
    { "action": "PasteExplorer", "shortkey": "ctrl-v", "when": "Explorer" },
    { "action": "PasteExplorer", "shortkey": "cmd-v", "when": "Explorer" },
    { "action": "DeleteExplorer", "shortkey": "delete", "when": "Explorer" },
    { "action": "FilterExplorer", "shortkey": "ctrl-f", "when": "Explorer" },
    { "action": "FilterExplorer", "shortkey": "cmd-f", "when": "Explorer" },
    { "action": "ClearExplorerInput", "shortkey": "escape", "when": "Explorer" },
    { "action": "TerminalCopyOrInterrupt", "shortkey": "ctrl-c", "when": "Terminal" },
    { "action": "ZoomInContent", "shortkey": "ctrl-=", "when": null },
    { "action": "ZoomInContent", "shortkey": "ctrl-+", "when": null },
    { "action": "ZoomOutContent", "shortkey": "ctrl--", "when": null },
    { "action": "ResetContentZoom", "shortkey": "ctrl-0", "when": null },
    { "action": "ZoomInUi", "shortkey": "ctrl-shift-=", "when": null },
    { "action": "ZoomInUi", "shortkey": "ctrl-shift-+", "when": null },
    { "action": "ZoomOutUi", "shortkey": "ctrl-shift--", "when": null },
    { "action": "ResetUiZoom", "shortkey": "ctrl-shift-0", "when": null }
  ]
}
