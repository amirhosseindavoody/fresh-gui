{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fresh-gui",
  "version": "2026.728.1",
  "identifier": "com.amirhosseindavoody.fresh-gui",
  "build": {
    "frontendDist": "../fresh-gui-app/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "fresh-gui",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
